flowchart LR

subgraph L1["1 · INGESTION — batch, frozen query"]
  direction TB
  OA["<b>OpenAlex</b> · pyalex<br/>6 term variants<br/>2015 → 2025-08<br/>dedupe ID + DOI"]
  EU["<b>PubMed E-utils</b><br/>Bio.Entrez · 10 req/s<br/>MeSH + AbstractText<br/>(beats OpenAlex text)"]
  CORP["<b>corpus.csv</b><br/>1,532 works<br/>368 pass filter"]
  FUT["<b>corpus_future.csv</b><br/>HELD OUT · 340 works<br/>2025-09 → 2026-08"]
  XML["<b>raw_cache/*.xml</b><br/>910 records<br/>in the image"]
  OA --> CORP
  OA --> FUT
  EU --> CORP
  EU --> FUT
  EU --> XML
end

SCH["<b>Cloud Scheduler</b><br/>0 7 * * *<br/>America/New_York"]
SEC["<b>Secret Manager</b><br/>GEMINI_API_KEY<br/>NCBI_API_KEY"]

subgraph L2["2 · AGENT LOOP — Cloud Run Job gapfinder-agent · 1 run = 1 cycle"]
  direction TB
  A1["<b>1 · pull state</b>"]
  A2["<b>2 · ingest</b><br/>next N papers<br/>replay or live"]
  A3["<b>3 · extract</b><br/>Gemini 3.5 Flash-Lite<br/>GenAI SDK · Pydantic<br/>verbatim-or-null<br/>cached · retry ladder"]
  A4["<b>4 · rebuild grid</b><br/>deterministic, no LLM<br/>species × model × outcome<br/>4 states + denominators"]
  A5["<b>5 · diff engine</b><br/>deterministic, no LLM<br/>transitions only<br/>severity-ranked"]
  A6["<b>6 · render alert</b><br/>or 'no material change'"]
  A7["<b>7 · push state</b><br/>+ timestamped history"]
  A1 --> A2 --> A3 --> A4 --> A5 --> A6 --> A7
end

GCS["<b>STATE</b><br/>gs://gapfinder-state<br/>─────────<br/>grid.json<br/>extractions.jsonl<br/>events_log.jsonl<br/>agent_state.json<br/>state_history/"]

subgraph L3["3 · DASHBOARD — Cloud Run service gapfinder-dashboard"]
  direction TB
  API["<b>FastAPI</b> · read-only<br/>/api/grid · /api/events<br/>/api/alert · /api/network<br/>60 s cache"]
  UI["<b>public browser UI</b><br/>heatmap · alert feed<br/>paper network<br/>stale banner &gt; 26 h"]
  API --> UI
end

